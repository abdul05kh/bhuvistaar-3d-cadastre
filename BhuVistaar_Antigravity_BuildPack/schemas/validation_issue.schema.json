{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ValidationIssue",
  "type": "object",
  "required": [
    "rule_code",
    "severity",
    "object_id",
    "passed",
    "message"
  ],
  "properties": {
    "rule_code": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "INFO",
        "WARN",
        "ERROR",
        "BLOCKER"
      ]
    },
    "object_id": {
      "type": "string"
    },
    "passed": {
      "type": "boolean"
    },
    "message": {
      "type": "string"
    },
    "measured_value": {},
    "threshold": {},
    "suggested_action": {
      "type": "string"
    }
  },
  "additionalProperties": false
}