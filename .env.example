# BhuVistaar — 3D Cadastral Intelligence & Validation Platform
# Environment Configuration Template (.env.example)
# NOTE: Never commit production credentials or secrets.

# Authoritative Persistence Configuration (PostgreSQL 16 + PostGIS 3.4)
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@127.0.0.1:5432/bhuvistaar_cadastre
CANONICAL_STORAGE_SRID=32643
CANONICAL_STORAGE_CRS=EPSG:32643

# Runtime & Deployment Profile (demo, development, test, production_simulation)
APP_ENV=demo
DEMO_MODE=true
LOG_LEVEL=INFO
API_BASE_URL=http://127.0.0.1:8000
FRONTEND_BASE_URL=http://127.0.0.1:5173

# Authorization & Security
AUTHORIZATION_MODE=SIMULATED_PROTOTYPE
MAX_UPLOAD_SIZE_BYTES=10485760

# AI Intelligence Layer (LOCAL, DETERMINISTIC, DISABLED)
AI_MODE=LOCAL
AI_ASSISTANCE_ENABLED=true
AI_CONFIDENCE_THRESHOLD_HIGH=0.85
AI_CONFIDENCE_THRESHOLD_MEDIUM=0.60

# Cadastral Validation Engine Tolerances
ADJACENCY_TOLERANCE_M=0.001
OVERLAP_THRESHOLD_M=0.001
PLANAR_CONTAINMENT_TOLERANCE_M=0.001
COORDINATE_PRECISION_DECIMALS=3
STALE_THRESHOLD_SECONDS=3600
